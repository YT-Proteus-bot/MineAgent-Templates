# 复制为 .env 并填入你的 key（网页上配置过的话可以不填）
MINEAGENT_API_KEY=sk-xxxx
MINEAGENT_BASE_URL=https://api.deepseek.com/v1
MINEAGENT_MODEL=deepseek-v4-pro

# 模型调用超时 / 客户端重试次数（节点级超时只是兜底，这里才是硬中断）
MINEAGENT_LLM_TIMEOUT=120
MINEAGENT_LLM_MAX_RETRIES=2

# 服务鉴权 / 并发（服务设置里配过则不用改）
MINEAGENT_AUTH=none
MINEAGENT_SERVICE_KEY=
MINEAGENT_MAX_CONCURRENCY=4

# 向量模型 / 向量库 / 数据源的访问密钥（在网页「用户中心」配置过则不用填）

# 外部数据中台（服务设置 → 数据连接）
MINEAGENT_DATA_TOKEN=
# 外部评测中台（服务设置 → 评测连接）
MINEAGENT_EVAL_TOKEN=
