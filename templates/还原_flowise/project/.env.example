# 复制为 .env 并填入你的 key（网页上配置过的话可以不填）
MINEAGENT_API_KEY=sk-xxxx
MINEAGENT_BASE_URL=https://api.deepseek.com/v1
MINEAGENT_MODEL=deepseek-v4-pro

# 模型调用超时 / 客户端重试次数（节点级超时只是兜底，这里才是硬中断）
MINEAGENT_LLM_TIMEOUT=120
MINEAGENT_LLM_MAX_RETRIES=2

# 服务鉴权 / 并发（服务设置里配过则不用改）
MINEAGENT_AUTH=none
MINEAGENT_SERVICE_KEY=
MINEAGENT_MAX_CONCURRENCY=4

# 会话治理：同一个 thread_id 的轮数上限与过期时间（0 表示不限）
MINEAGENT_MAX_TURNS=20
MINEAGENT_SESSION_TTL=1440

# 断点续跑：0 时 /resume 返回 501（画布上有审批节点就需要开成 1）
MINEAGENT_RESUME=0

# trace 采样率：0 不落、1 全落、中间按比例（也作用于 OTel span）
MINEAGENT_TRACE_SAMPLE=1

# 可观测：trace 落盘（留空则不落）/ OTel 导出（留空则不导出）
MINEAGENT_TRACE_FILE=outputs/traces/{date}.jsonl
MINEAGENT_OTEL_ENDPOINT=

# 成本：每 1K token 单价（填了才会算 cost_usd）；预算耗尽会返回 429
MINEAGENT_PRICE_INPUT_PER_1K=0
MINEAGENT_PRICE_OUTPUT_PER_1K=0
MINEAGENT_BUDGET_USD=0

# 灰度：0=全走主版本，100=全走 canary；header X-Canary 可强制
MINEAGENT_CANARY_PERCENT=0
MINEAGENT_CANARY_MODEL=
MINEAGENT_CANARY_BASE_URL=
MINEAGENT_CANARY_API_KEY=
MINEAGENT_CANARY_VERSION=
MINEAGENT_CANARY_LABEL=

# 密钥来源：env（默认）/ file / vault；环境变量仍然优先
MINEAGENT_SECRETS=env
MINEAGENT_SECRETS_FILE=
MINEAGENT_VAULT_ADDR=
MINEAGENT_VAULT_TOKEN=
MINEAGENT_VAULT_MOUNT=secret
MINEAGENT_VAULT_PATH=mineagent

# 向量模型 / 向量库 / 数据源的访问密钥（在网页「用户中心」配置过则不用填）

# 外部数据中台（服务设置 → 数据连接）
MINEAGENT_DATA_TOKEN=
# 外部评测中台（服务设置 → 评测连接）
MINEAGENT_EVAL_TOKEN=
